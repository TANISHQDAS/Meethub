# ==========================================
# MEETHUB - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini AI (For Summaries, Action Items, Sentiment & Meeting Copilot)
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud (For Sub-Second Whisper-large-v3 Transcription)
# Get a free API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 3. Supabase (Database & Auth)
# Get from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. Gmail SMTP Configuration (For Sending Meeting Summary Recaps)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_character_app_password
